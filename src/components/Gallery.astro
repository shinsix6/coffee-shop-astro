---
const photos = [
	{
		img: 'https://images.unsplash.com/photo-1521017432531-fbd92d768814?w=1200&q=80&auto=format&fit=crop',
		alt: 'Wide view of the shop: long communal table, counter, and a customer reading by the window',
		span: 'md:col-span-8 aspect-[16/10]',
	},
	{
		img: 'https://images.unsplash.com/photo-1442512595331-e89e73853f31?w=800&q=80&auto=format&fit=crop',
		alt: 'A barista pouring hot water over a pour-over cone',
		span: 'md:col-span-4 aspect-[4/3]',
	},
	{
		img: 'https://images.unsplash.com/photo-1493857671505-72967e2e2760?w=800&q=80&auto=format&fit=crop',
		alt: 'Bicycles parked along the front counter beneath a menu board',
		span: 'md:col-span-4 aspect-[4/3]',
	},
	{
		img: 'https://images.unsplash.com/photo-1559305616-3f99cd43e353?w=800&q=80&auto=format&fit=crop',
		alt: 'The service counter with pendant lights and chalk menu boards',
		span: 'md:col-span-4 aspect-[4/3]',
	},
	{
		img: 'https://images.unsplash.com/photo-1453614512568-c4024d13c247?w=1200&q=80&auto=format&fit=crop',
		alt: 'The espresso bar with an open cabinet of drawers and shelves of plants',
		span: 'md:col-span-8 aspect-[16/10]',
	},
];
---

<section class="px-6 py-[clamp(4rem,8vw,8rem)]">
	<div class="mx-auto max-w-[1280px] space-y-12">
		<div class="max-w-2xl space-y-6">
			<p class="text-sm font-medium tracking-[0.2em] text-accent uppercase">The Room</p>
			<svg width="120" height="16" viewBox="0 0 120 16" fill="none" aria-hidden="true">
				<path d="M2 12 C 30 -4, 50 24, 80 8 S 110 2, 118 6" stroke="#cfb53b" stroke-width="1.5" stroke-linecap="round" />
			</svg>
			<h2 class="text-3xl font-bold tracking-tight text-charcoal">The place, as it actually looks.</h2>
		</div>

		<!-- Asymmetric grid: varied tile sizes per DESIGN.md, no equal columns -->
		<div class="grid gap-6 md:grid-cols-12">
			{
				photos.map((photo, i) => (
					<figure class:list={['overflow-hidden rounded-xl', photo.span]} style={`animation-delay: ${i * 100}ms`}>
						<img
							src={photo.img}
							alt={photo.alt}
							loading="lazy"
							class="gallery-photo h-full w-full object-cover transition duration-200 hover:scale-[1.03]"
						/>
					</figure>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Entry: fade + translate-Y per DESIGN.md, staggered 100ms via inline delay */
	figure {
		animation: gallery-rise 480ms ease-out both;
	}

	@keyframes gallery-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		figure {
			animation: none;
		}
	}
</style>